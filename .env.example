# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trading Dashboard (see docs/trading-setup.md)
ADVISOR_API_URL=https://your-advisor-api.com
ADVISOR_ACCESS_TOKEN=your_access_token_here
TRADING_PASSWORD=your-secure-password
OPENAI_API_KEY=sk-your-openai-key
CRYPTOCOMPARE_API_KEY=your-cryptocompare-key
LLM_MODEL=gpt-4o-mini

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual credentials
# 3. Never commit .env.local to git (it's in .gitignore)

